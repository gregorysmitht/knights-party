{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/host", "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ] },
    { "source": "/party.ics", "headers": [
      { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
      { "key": "Content-Disposition", "value": "attachment; filename=\"knights-volleyball-party.ics\"" }
    ] }
  ]
}
